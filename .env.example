# Contentful credentials
NEXT_PUBLIC_BUSOLA_CMS_API_KEY=
NEXT_PUBLIC_BUSOLA_CMS_ENVIRONMENT=
NEXT_PUBLIC_BUSOLA_CMS_SPACE_ID=


NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_INTERNAL_API_URL=

NEXT_PUBLIC_WEBSOCKET_URL=

# Contact form delivery. Set to route-handler for the Vercel/Resend solution.
NEXT_PUBLIC_CONTACT_MESSAGE_DELIVERY=external-backend

# Required only when NEXT_PUBLIC_CONTACT_MESSAGE_DELIVERY=route-handler.
# CONTACT_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Student portal login. Disabled by default, including in production.
NEXT_PUBLIC_ENABLE_LOGIN=false

# External shop URL. Leave empty to hide the Sklep navigation link.
NEXT_PUBLIC_SHOP_URL=
